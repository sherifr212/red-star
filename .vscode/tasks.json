{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build: RedStar.Cli",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}\\src\\RedStar.Cli\\RedStar.Cli.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Format Codebase (Butler + dotnet format)",
            "type": "shell",
            "command": "./format-code.sh",
            "windows": {
                "command": ".\\format-code.ps1",
                "options": {
                    "cwd": "${workspaceFolder}\\src"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}